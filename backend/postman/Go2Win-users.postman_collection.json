  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const value = {\"username\": \"{{username}}\", \"password\": \"{{password}}\"};",
              "function resolve(v) { if (typeof v === 'string' && /^\\{\\{\\w+\\}\\}$/.test(v)) { const key=v.slice(2,-2); const raw=pm.collectionVariables.get(key); if (key==='supervisor_id') return raw && raw!=='null' ? Number(raw) : null; if (key==='campaign_id') return Number(raw); return raw; } if (v && typeof v==='object') for (const k of Object.keys(v)) v[k]=resolve(v[k]); return v; } pm.request.body.update(JSON.stringify(resolve(value)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200) pm.collectionVariables.set('access_token',pm.response.json().access_token); else pm.collectionVariables.set('access_token','');"
            ]
          }
        }
      ]
    },
