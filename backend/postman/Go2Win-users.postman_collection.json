    {
      "name": "21 Crear perfil de prueba",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/profiles",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{profile_name}}\",\n  \"actor_type\": \"{{actor_type}}\",\n  \"notes\": \"{{profile_notes}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body={\"name\": \"{{profile_name}}\", \"actor_type\": \"{{actor_type}}\", \"notes\": \"{{profile_notes}}\"};for (const k of Object.keys(body)) { const v=body[k]; if (typeof v==='string' && v.startsWith('{{')) body[k]=pm.collectionVariables.get(v.slice(2,-2)); } if ('ends_at' in body && !body.ends_at) body.ends_at=null; pm.request.body.update(JSON.stringify(body));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===201) pm.collectionVariables.set('profile_id',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Consultar trayectorias",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/profile-positions",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": []
      }
    },
    {
      "name": "23 Guardar trayectoria",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/profiles/{{profile_id}}/positions",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"office\": \"{{position_office}}\",\n  \"condition\": \"{{position_condition}}\",\n  \"starts_at\": \"{{position_start}}\",\n  \"ends_at\": \"{{position_end}}\",\n  \"party_or_coalition\": \"{{position_party}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body={\"office\": \"{{position_office}}\", \"condition\": \"{{position_condition}}\", \"starts_at\": \"{{position_start}}\", \"ends_at\": \"{{position_end}}\", \"party_or_coalition\": \"{{position_party}}\"};for (const k of Object.keys(body)) { const v=body[k]; if (typeof v==='string' && v.startsWith('{{')) body[k]=pm.collectionVariables.get(v.slice(2,-2)); } if ('ends_at' in body && !body.ends_at) body.ends_at=null; pm.request.body.update(JSON.stringify(body));"
            ]
          }
        }
      ]
    },
    {
