  "item": [
    {
      "name": "Salud",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/health"
      }
    },
    {
      "name": "PostgreSQL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{admin_key}}"
          }
        ],
        "url": "{{base_url}}/api/v1/health/database"
      }
    },
    {
      "name": "Generar código",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{admin_key}}"
          }
        ],
        "url": "{{base_url}}/api/v1/workers/{{worker_id}}/telegram/activation-codes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código creado', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('activation_code', pm.response.json().activation_code);"
            ]
          }
        }
      ]
    },
    {
      "name": "Vincular",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/integrations/telegram/updates",
        "header": [
          {
            "key": "X-Telegram-Bot-Api-Secret-Token",
            "value": "{{telegram_secret}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"update_id\": 10001,\n  \"message\": {\n    \"message_id\": 15,\n    \"from\": {\"id\": {{telegram_user_id}}, \"is_bot\": false},\n    \"chat\": {\"id\": {{telegram_user_id}}, \"type\": \"private\"},\n    \"text\": \"/start {{activation_code}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Vinculación o reintento', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.be.oneOf(['linked', 'already_linked']); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Código inválido",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/integrations/telegram/updates",
        "header": [
          {
            "key": "X-Telegram-Bot-Api-Secret-Token",
            "value": "{{telegram_secret}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"update_id\":10002,\"message\":{\"message_id\":16,\"from\":{\"id\":987654321,\"is_bot\":false},\"chat\":{\"id\":987654321,\"type\":\"private\"},\"text\":\"/start INVALIDO\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechazado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('rejected'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar tareas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Telegram-Bot-Api-Secret-Token",
            "value": "{{telegram_secret}}"
          }
        ],
        "url": "{{base_url}}/api/v1/integrations/telegram/users/{{telegram_user_id}}/tasks?after=0&limit=3"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 && pm.response.json().items.length) pm.collectionVariables.set('task_id', pm.response.json().items[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle tarea",
      "request": {
        "method": "GET",
