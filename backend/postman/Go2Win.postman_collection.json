      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_key",
      "value": ""
    },
    {
      "key": "telegram_secret",
      "value": ""
    },
    {
      "key": "worker_id",
      "value": ""
    },
    {
      "key": "telegram_user_id",
      "value": "123456789"
    },
    {
      "key": "activation_code",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    },
    {
      "key": "task_generation",
      "value": ""
    },
    {
      "key": "report_body",
      "value": "Avance de prueba"
    },
    {
      "key": "callback_id",
      "value": "postman-report-1"
