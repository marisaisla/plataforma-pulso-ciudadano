      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body = JSON.parse(pm.request.body.raw); function walk(v) { if (typeof v === 'string') return pm.variables.replaceIn(v); if (v && typeof v === 'object') for (const k of Object.keys(v)) v[k] = walk(v[k]); return v; } body = walk(body); const uid = Number(pm.collectionVariables.get('telegram_user_id')); if (body.message) { body.message.from.id = uid; body.message.chat.id = uid; body.message.date = Math.floor(Date.now()/1000); if (body.message.text !== '/reportar' && body.message.text !== '/cancelar') { body.message.message_id = Number(pm.collectionVariables.get('report_message_id')); body.message.text = pm.collectionVariables.get('report_body'); } } if (body.callback_query) { body.callback_query.from.id = uid; body.callback_query.message.chat.id = uid; } pm.request.body.update(JSON.stringify(body));"
            ]
          }
        }
      ]
