              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body={\"status\": \"En curso\", \"evidence_note\": \"{{evidence_note}}\"};function resolve(v) { if(typeof v==='string' && v.startsWith('{{')) { const key=v.slice(2,-2), raw=pm.collectionVariables.get(key); if(key==='assignment_worker_id') { if(raw==='null') return null; if(!raw || !Number.isInteger(Number(raw)) || Number(raw)<=0) throw new Error('Configura assignment_worker_id con un ID o null explícito.'); return Number(raw); } if(key==='strategy_id') { if(!raw || !Number.isInteger(Number(raw)) || Number(raw)<=0) throw new Error('Configura strategy_id.'); return Number(raw); } return raw; } if(v && typeof v==='object') for(const k of Object.keys(v)) v[k]=resolve(v[k]); return v; } pm.request.body.update(JSON.stringify(resolve(body)));"
            ]
          }
        }
      ]
    },
