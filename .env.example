# Copiar a .env en CADA computadora. No versionar credenciales.
# Carpeta compartida para insumos y entregables de todas las computadoras.
GO2WIN_FILES_ROOT=\\MARISA\Go2WinDatos
DB_BACKEND=postgresql
API_BASE_URL=http://127.0.0.1:8000
# URL HTTPS de la pantalla Streamlit, leída por FastAPI para los botones de cuestionarios.
# Dejar vacía mientras no exista acceso HTTPS desde los celulares.
GO2WIN_PUBLIC_URL=
PGHOST=192.168.1.10
PGPORT=5432
PGDATABASE=go2win_desarrollo
PGUSER=go2win_marisa
# Configurar contraseña individualmente mediante el mecanismo habitual.
